#!name = Vomic 漫画签到
#!desc = 打开App自动签到 v2.0.5 — 拦截查询响应拿签名
#!author = Zerolost
#!icon = https://vomicmh.com/images/light.png
#!system = ios
#!loon_version = 3.2.1(733)
#!tag = 签到

[Argument]
EnableSign = switch,true,tag=签到开关,desc=打开App时自动签到
EnableCookie = switch,true,tag=Cookie提取开关,desc=自动抓取Authorization Token
EnableDebug = switch,false,tag=调试模式,desc=开启详细日志(排查用)
SignCron = input,"30 8 * * *",tag=定时签到,desc=cron表达式(默认每天08:30)

[Script]
http-request ^https?:\/\/api\.vomicmh\.com\/ script-path=https://raw.githubusercontent.com/Zerolost/VqssLs/main/Script/VomicSign5/VomicSign5.js, tag=Vomic抓Cookie, enable={EnableCookie}, timeout=15
http-response ^https?:\/\/api\.vomicmh\.com\/pics_new\/pics\/c\/getSignMonthInfo script-path=https://raw.githubusercontent.com/Zerolost/VqssLs/main/Script/VomicSign5/VomicSign5.js, tag=Vomic自动签到, enable={EnableSign}, timeout=60, requires-body=true
cron {SignCron} script-path=https://raw.githubusercontent.com/Zerolost/VqssLs/main/Script/VomicSign5/VomicSign5.js, tag=Vomic定时签到, enable={EnableSign}, timeout=30

[MITM]
hostname = api.vomicmh.com
