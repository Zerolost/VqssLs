#!tag = 签到

[Argument]
EnableSign = switch,true,tag=签到开关,desc=打开App时自动签到

[Script]
http-response ^https?:\/\/api\.vomicmh\.com\/pics_new\/pics\/c\/(recommend|homePage|getBanner) script-path=https://raw.githubusercontent.com/Zerolost/VqssLs/main/Script/Vomic/VomicSign.js, tag=Vomic签到, enable={EnableSign}, timeout=60, requires-body=false

[MITM]
hostname = api.vomicmh.com
