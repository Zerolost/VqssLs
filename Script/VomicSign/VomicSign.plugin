#!name = Vomic 漫画签到
#!desc = 打开 Vomic App 自动签到 v2.0.1
#!author = Zerolost
#!icon = https://vomicmh.com/images/light.png
#!system = ios
#!loon_version = 3.2.1(733)
#!tag = 签到

[Argument]
EnableSign = switch,true,tag=签到开关,desc=打开App时自动签到
EnableCookie = switch,true,tag=Cookie提取开关,desc=自动抓取Authorization Token
EnableDebug = switch,false,tag=调试模式,desc=开启详细日志(排查用)

[Script]
http-request ^https?:\/\/api\.vomicmh\.com\/ script-path=https://raw.githubusercontent.com/Zerolost/VqssLs/main/Script/VomicSign/VomicSign.js, tag=Vomic抓Cookie, enable={EnableCookie}, timeout=15
http-response ^https?:\/\/api\.vomicmh\.com\/pics_new\/pics\/c\/(recommend|homePage|getBanner) script-path=https://raw.githubusercontent.com/Zerolost/VqssLs/main/Script/VomicSign/VomicSign.js, tag=Vomic签到, enable={EnableSign}, timeout=60, requires-body=false

[MITM]
hostname = api.vomicmh.com
