#!name = Vomic漫画签到
#!desc = Vomic漫画自动签到，每日领取经验与金币
#!icon = https://vomicmh.com/images/light.png
#!system = ios

[Argument]
VomicSignEnable = switch,true,tag=Vomic签到开关,desc=是否启用 Vomic 自动签到
VomicSignCron = input,"30 8 * * *",tag=Vomic签到时间,desc=签到定时 cron 表达式（默认每天 08:30）

[Script]
cron {VomicSignCron} script-path=https://raw.githubusercontent.com/Zerolost/VqssLs/main/Script/Loon/Vomic.js, tag=Vomic自动签到, enable={VomicSignEnable}, timeout=30
http-request ^https?:\/\/api\.vomicmh\.com\/.* script-path=https://raw.githubusercontent.com/Zerolost/VqssLs/main/Script/Loon/Vomic.js, tag=Vomic获取Cookie, enable=true, timeout=15

[MITM]
hostname = api.vomicmh.com