#!name=小黑盒每日签到
#!desc=自动获取小黑盒 Cookie 和设备参数，每天调用新版接口签到；需自建 Hkey Server。
#!author=Zerolost

[Script]
# 独立 Cookie/设备参数抓取：启用插件后打开一次小黑盒 App
http-request ^https:\/\/api\.xiaoheihe\.cn\/.* script-path=https://raw.githubusercontent.com/Zerolost/VqssLs/main/Script/Loon/cookie-capture.js, requires-body=false, timeout=10, tag=小黑盒 Cookie 抓取

# 每天 08:05 签到。请将下面 YOUR-HKEY-SERVER 替换为自己的服务地址
cron "5 8 * * *" script-path=https://raw.githubusercontent.com/Zerolost/VqssLs/main/Script/Loon/heybox-checkin.js, timeout=45, tag=小黑盒每日签到, argument=hkey=https%3A%2F%2FYOUR-HKEY-SERVER%2Fencode

[MITM]
hostname = %APPEND% api.xiaoheihe.cn
