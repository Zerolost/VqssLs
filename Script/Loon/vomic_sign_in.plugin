#!name = Vomic 签到
#!desc = Vomic 漫画自动签到 v1.0.0
#!author = Zerolost
#!icon = https://vomicmh.com/images/light.png
#!system = ios
#!loon_version = 3.2.1(733)
#!tag = 签到

[Argument]
SignSwitch = switch,true,tag=签到开关,desc=是否启用自动签到
CookieSwitch = switch,true,tag=Cookie开关,desc=是否自动提取Token
SignCron = input,"30 8 * * *",tag=签到时间,desc=cron表达式(默认每天08:30)

[Script]
cron {SignCron} script-path=https://raw.githubusercontent.com/Zerolost/VqssLs/main/Script/Loon/vomic_sign_in.js, tag=Vomic签到, enable={SignSwitch}, timeout=30
http-request ^https?:\/\/api\.vomicmh\.com\/ script-path=https://raw.githubusercontent.com/Zerolost/VqssLs/main/Script/Loon/vomic_sign_in.js, tag=Vomic获取Cookie, enable={CookieSwitch}, timeout=15

[MITM]
hostname = api.vomicmh.com
