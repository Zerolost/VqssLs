#!name = 源论坛每日签到
#!desc = 自动完成ycoo.net每日签到,支持自动抓取Cookie、自定义签到时间
#!category = 签到

[Argument]
自动抓取Cookie = switch,true,tag=[开关] 自动抓取Cookie,desc=浏览ycoo.net网页时自动保存登录Cookie,建议保持开启
RunTime = input,"30 8 * * *",tag=自定义签到时间,desc=可手动更改签到运行时间,默认每天8点30

[Script]
cron {RunTime} script-path=https://raw.githubusercontent.com/Zerolost/VqssLs/main/Script/Loon/ycoo.js, tag=源论坛每日签到, timeout=30

http-response ^https?:\/\/ycoo\.net\/(forum\.php|k_misign-sign\.html) script-path=https://raw.githubusercontent.com/Zerolost/VqssLs/main/Script/Loon/ycoo.js, tag=源论坛Cookie获取, enable={自动抓取Cookie}, timeout=15

[MITM]
hostname = ycoo.net