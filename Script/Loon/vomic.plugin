#!name=Vomic签到
#!desc=实现Vomic每日签到

[Argument]
CaptureToken = switch,true,tag=自动抓取Token,desc=自动监听请求并更新登录Token
Notify = switch,true,tag=签到通知,desc=开启签到结果通知
Debug = switch,false,tag=调试日志,desc=输出详细日志
RunTime = input,"30 8 * * *",tag=签到时间,desc=Cron表达式

[Script]
cron {RunTime} script-path=https://raw.githubusercontent.com/Zerolost/VqssLs/main/Script/Loon/Vomic.js, tag=Vomic自动签到, timeout=30, argument=cron&notify={Notify}&debug={Debug}

http-request ^https:\/\/api\.vomicmh\.com\/pics_new\/pics\/c\/.* script-path=https://raw.githubusercontent.com/Zerolost/VqssLs/main/Script/Loon/Vomic.js, tag=Vomic获取Token, requires-body=false, enable={CaptureToken}, timeout=15, argument=capture&debug={Debug}

[MITM]
hostname = api.vomicmh.com