#!name=扫描全能王·幸运大转盘
#!desc=每日自动完成「看视频抽奖」幸运大转盘(每日最多3次),无需真看视频,自动转盘领奖。奖品为云存储/优惠券/VIP。
#!author=MaYIHEI
#!homepage=https://github.com/MaYIHEI/paperclip/tree/refs/heads/main/app/camscanner
#!icon=https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/camscanner.png

[Argument]
Cookie = switch,true,tag=[开关] Cookie获取,desc=是否启用此处修改

RunTime = input,"15 10 * * *",tag=自定义执行时间,desc=可手动更改脚本运行时间，默认上午10点15分

[Script]
cron {RunTime} script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/camscanner/camscanner.js, tag=自动签到, enable={Cron}

http-request ^https:\/\/api-cs\.intsig\.net\/user\/cs\/get_user_attribute script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/camscanner/camscanner.cookie.jscamscanner/camscanner.cookie.js, tag=Cookie获取, enable={Cookie}

[MITM]
hostname = api-cs.intsig.net